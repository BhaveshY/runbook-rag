# Model calls go through the Codex CLI (`codex login` with a ChatGPT plan) by default.
# Set RUNBOOK_BACKEND=openai and OPENAI_API_KEY to use the OpenAI API instead.
RUNBOOK_BACKEND=codex
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RUNBOOK_MODEL=gpt-5.6-luna
RUNBOOK_RERANK_MODEL=gpt-5.6-luna
RUNBOOK_REVIEW_MODEL=gpt-5.6-luna
# Judge model used only by `evaluate --answers`.
RUNBOOK_JUDGE_MODEL=gpt-5.6-sol
RUNBOOK_JUDGE_REASONING=low
# Local embedding model, run on the CPU through fastembed.
RUNBOOK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RUNBOOK_EMBEDDING_DIMENSIONS=384
# Optional. Protect a deployed instance with a bearer token.
RUNBOOK_ACCESS_TOKEN=
# Paid requests allowed per UTC day in this process. The count also resets on restart.
# In production, enforce quotas at an API gateway.
RUNBOOK_DAILY_REQUEST_LIMIT=200
# Optional. Where the index lives. Defaults to data/ in a checkout, or in the current
# directory for an installed package.
# RUNBOOK_DATA_DIR=/absolute/path/to/data
# Optional. Where the embedding model is cached. Defaults to data/models.
# RUNBOOK_MODEL_CACHE=/absolute/path/to/models
# Optional. Path of the evaluation report. The server reads it, and `evaluate` writes
# it unless you pass --output.
# RUNBOOK_EVAL_REPORT=/absolute/path/to/eval/results/latest.json
