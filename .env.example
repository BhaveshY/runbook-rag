OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RUNBOOK_MODEL=gpt-5.4-mini
RUNBOOK_RERANK_MODEL=gpt-5.4-nano
RUNBOOK_REVIEW_MODEL=gpt-5.4-mini
RUNBOOK_EMBEDDING_MODEL=text-embedding-3-small
RUNBOOK_EMBEDDING_DIMENSIONS=768
# Optional: protect a deployed instance with a bearer token.
RUNBOOK_ACCESS_TOKEN=
# Per-process paid request budget. Resets on restart; use gateway quotas in production.
RUNBOOK_DAILY_REQUEST_LIMIT=200
# Optional: where the service reads the measured report and evaluation writes by default.
# RUNBOOK_EVAL_REPORT=/absolute/path/to/eval/results/latest.json
